# Sensitive
.env
*.key
*.pem
credentials.json

# OS
.DS_Store
Thumbs.db

# Documents sources (gardés en local)
analyses/*/documents/*
!analyses/*/documents/.gitkeep

# Registre des affaires à suivre (prix plafonds + négociation = interne)
documents/suivi/

# Notes perso
notes.md
*.log

# Python
__pycache__/
*.pyc

# Veille enchères : document de projet et données internes (stratégie de financement,
# prix plafonds) — seul le code est versionné, jamais le PROJET.md ni la base.
documents/veille/encheres/*
!documents/veille/encheres/*.py
